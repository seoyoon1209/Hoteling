# back/.env 예시 — 복사해서 `.env`로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# 실제 .env 는 .gitignore 에 의해 커밋되지 않습니다.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_SERVICE_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- OpenAI (AI 인사이트 기능에 필요) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
